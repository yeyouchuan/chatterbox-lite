{
  "name": "chatterbox-lite",
  "private": true,
  "version": "2.3.1",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "desktop:dev": "electron-vite dev",
    "desktop:build": "electron-vite build",
    "desktop:pack": "bun run desktop:build && electron-builder --win portable --config.win.signAndEditExecutable=false",
    "preview": "vite preview",
    "lint": "biome check"
  },
  "build": {
    "appId": "cn.chatterbox.lite",
    "productName": "Chatterbox Lite",
    "files": [
      "out/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ]
    }
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@preact/signals": "^2.9.0",
    "clsx": "^2.1.1",
    "preact": "^10.29.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@preact/preset-vite": "^2.10.5",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "mpegts.js": "1.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.3",
    "vite-plugin-monkey": "^7.1.9"
  }
}
